#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define FILENAME "field_data.dat"
#define MOISTURE_THRESHOLD 35.0
#define HEALTH_THRESHOLD 60

typedef struct {
    int zone_id;
    double latitude;
    double longitude;
    float soil_moisture;
    float temperature;
    float humidity;
    int crop_health;
} SensorReading;

void recordReadings();
void generateReport();

int main() {
    int choice;

    while (1) {
        printf("\n=== Agricultural Robot Data System ===\n");
        printf("1. Store New Robot Readings\n");
        printf("2. Generate Field Monitoring & Irrigation Report\n");
        printf("3. Exit\n");
        printf("Enter choice: ");
        
        if (scanf("%d", &choice) != 1) {
            printf("Invalid input. Exiting.\n");
            break;
        }

        switch (choice) {
            case 1:
                recordReadings();
                break;
            case 2:
                generateReport();
                break;
            case 3:
                printf("Exiting system.\n");
                return 0;
            default:
                printf("Invalid choice. Please try again.\n");
        }
    }
    return 0;
}

void recordReadings() {
    FILE *file = fopen(FILENAME, "ab");
    if (file == NULL) {
        perror("Error opening file for writing");
        return;
    }

    int count;
    printf("\nHow many zone readings do you want to log? ");
    scanf("%d", &count);

    SensorReading data;
    for (int i = 0; i < count; i++) {
        printf("\n--- Entering Data for Reading #%d ---\n", i + 1);
        printf("Zone ID: ");
        scanf("%d", &data.zone_id);
        printf("GPS Latitude: ");
        scanf("%lf", &data.latitude);
        printf("GPS Longitude: ");
        scanf("%lf", &data.longitude);
        printf("Soil Moisture (%%): ");
        scanf("%f", &data.soil_moisture);
        printf("Temperature (°C): ");
        scanf("%f", &data.temperature);
        printf("Air Humidity (%%): ");
        scanf("%f", &data.humidity);
        printf("Crop Health Index (0-100): ");
        scanf("%d", &data.crop_health);

        fwrite(&data, sizeof(SensorReading), 1, file);
    }

    fclose(file);
    printf("\nSuccessfully saved %d reading(s) to %s.\n", count, FILENAME);
}

void generateReport() {
    FILE *file = fopen(FILENAME, "rb");
    if (file == NULL) {
        printf("\nNo stored data found. Please log readings first.\n");
        return;
    }

    SensorReading data;
    int total_zones = 0;
    int irrigation_needed_count = 0;
    float sum_moisture = 0, sum_temp = 0, sum_humidity = 0;

    printf("\n=========================================================================================\n");
    printf("                          FIELD MONITORING & IRRIGATION REPORT                           \n");
    printf("=========================================================================================\n");
    printf("%-6s | %-19s | %-8s | %-7s | %-8s | %-6s | %-15s\n", 
           "Zone", "GPS (Lat, Lon)", "Moisture", "Temp", "Humidity", "Health", "Status");
    printf("-----------------------------------------------------------------------------------------\n");

    while (fread(&data, sizeof(SensorReading), 1, file) == 1) {
        total_zones++;
        sum_moisture += data.soil_moisture;
        sum_temp += data.temperature;
        sum_humidity += data.humidity;

        char status[20];
        if (data.soil_moisture < MOISTURE_THRESHOLD) {
            strcpy(status, "IRRIGATE NOW");
            irrigation_needed_count++;
        } else if (data.crop_health < HEALTH_THRESHOLD) {
            strcpy(status, "CHECK CROP");
        } else {
            strcpy(status, "OPTIMAL");
        }

        printf("%-6d | %8.4f, %8.4f | %6.1f%%  | %5.1f°C | %6.1f%%  | %4d/100 | %-15s\n",
               data.zone_id, data.latitude, data.longitude,
               data.soil_moisture, data.temperature, data.humidity,
               data.crop_health, status);
    }

    printf("=========================================================================================\n");

    if (total_zones > 0) {
        printf("\n--- FIELD SUMMARY ---\n");
        printf("Total Zones Monitored   : %d\n", total_zones);
        printf("Average Soil Moisture   : %.2f%%\n", sum_moisture / total_zones);
        printf("Average Temperature     : %.2f°C\n", sum_temp / total_zones);
        printf("Average Humidity        : %.2f%%\n", sum_humidity / total_zones);
        printf("Zones Requiring Water   : %d (Threshold: < %.1f%%)\n", 
               irrigation_needed_count, MOISTURE_THRESHOLD);
    } else {
        printf("File is empty. No records to display.\n");
    }

    fclose(file);
}
