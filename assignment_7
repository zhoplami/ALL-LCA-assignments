#include <stdio.h>

#define MAX_ROBOTS 100

struct Robot {
    int id;
    char type[50];
    float payload_capacity;
    float actual_load;
    float operating_time;
    float utilization;
    int is_overloaded;
};

int main() {
    struct Robot robots[MAX_ROBOTS];
    int n, i, overload_count = 0;

    printf("Enter the number of robotic arms (max %d): ", MAX_ROBOTS);
    scanf("%d", &n);

    if (n <= 0 || n > MAX_ROBOTS) {
        printf("Invalid number of robots. Please enter a value between 1 and %d.\n", MAX_ROBOTS);
        return 1;
    }

    for (i = 0; i < n; i++) {
        printf("\n--- Enter details for Robot %d ---\n", i + 1);
        
        printf("Robot ID: ");
        scanf("%d", &robots[i].id);

        printf("Robot Type (e.g., Articulated, SCARA, Delta): ");
        scanf(" %[^\n]", robots[i].type);

        printf("Rated Payload Capacity (kg): ");
        scanf("%f", &robots[i].payload_capacity);

        printf("Actual Load (kg): ");
        scanf("%f", &robots[i].actual_load);

        printf("Operating Time (hours): ");
        scanf("%f", &robots[i].operating_time);

        if (robots[i].payload_capacity > 0) {
            robots[i].utilization = (robots[i].actual_load / robots[i].payload_capacity) * 100.0f;
        } else {
            robots[i].utilization = 0.0f;
        }

        if (robots[i].actual_load > robots[i].payload_capacity) {
            robots[i].is_overloaded = 1;
            overload_count++;
        } else {
            robots[i].is_overloaded = 0;
        }
    }

    printf("\n==========================================================================================\n");
    printf("%-8s %-18s %-14s %-12s %-12s %-14s %-10s\n", 
           "ID", "Type", "Capacity(kg)", "Load(kg)", "Time(hrs)", "Utilization", "Status");
    printf("==========================================================================================\n");

    for (i = 0; i < n; i++) {
        printf("%-8d %-18s %-14.2f %-12.2f %-12.2f %-13.2f%% %-10s\n",
               robots[i].id,
               robots[i].type,
               robots[i].payload_capacity,
               robots[i].actual_load,
               robots[i].operating_time,
               robots[i].utilization,
               robots[i].is_overloaded ? "OVERLOAD!" : "Normal");
    }
    printf("==========================================================================================\n");

    if (overload_count > 0) {
        printf("\n[WARNING] %d robot(s) operating beyond rated payload capacity:\n", overload_count);
        for (i = 0; i < n; i++) {
            if (robots[i].is_overloaded) {
                float excess = robots[i].actual_load - robots[i].payload_capacity;
                printf(" -> Robot ID %d (%s): Exceeded by %.2f kg (%.2f%% utilization)\n",
                       robots[i].id, robots[i].type, excess, robots[i].utilization);
            }
        }
    } else {
        printf("\nAll robots are operating within their safe payload limits.\n");
    }

    return 0;
}
