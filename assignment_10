#include <stdio.h>

int isLeapYear(int year) {
    return (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
}

int getFirstDayOfYear(int year) {
    int y = year - 1;
    return (1 + y + y / 4 - y / 100 + y / 400) % 7;
}

int getDaysInMonth(int month, int year) {
    int days[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
    if (month == 1 && isLeapYear(year)) {
        return 29;
    }
    return days[month];
}

void printCalendar(int year) {
    char *months[] = {
        "January", "February", "March", "April",
        "May", "June", "July", "August",
        "September", "October", "November", "December"
    };

    int currentDay = getFirstDayOfYear(year);

    printf("\n============== CALENDAR - %d ==============\n", year);

    for (int month = 0; month < 12; month++) {
        int daysInMonth = getDaysInMonth(month, year);

        printf("\n  ------------ %s ------------\n", months[month]);
        printf("  Sun  Mon  Tue  Wed  Thu  Fri  Sat\n");

        for (int space = 0; space < currentDay; space++) {
            printf("     ");
        }

        for (int day = 1; day <= daysInMonth; day++) {
            printf("%5d", day);

            if (++currentDay > 6) {
                currentDay = 0;
                printf("\n");
            }
        }

        if (currentDay != 0) {
            printf("\n");
        }
    }
}

int main() {
    int year;

    printf("Enter a year (e.g., 2026): ");
    if (scanf("%d", &year) != 1 || year < 1) {
        printf("Invalid input. Please enter a valid positive year.\n");
        return 1;
    }

    printCalendar(year);

    return 0;
}
